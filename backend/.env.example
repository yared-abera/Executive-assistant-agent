# Google AI Studio — https://ai.google.dev (AIza… key)
GEMINI_API_KEY=

# Supabase free tier — run docs/supabase_schema.sql in the SQL editor
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=

# Resend free tier — https://resend.com
# Use onboarding@resend.dev until you verify your own domain.
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=beth.t@example.com
# Inbox that receives briefings / demo mail (often your Resend signup email)
EXECUTIVE_EMAIL=you@example.com
# simulate = never call Resend (demo). omit/auto = try Resend, fall back to simulate on domain blocks
# EMAIL_MODE=simulate

# Google Calendar OAuth (single demo executive calendar)
# Create OAuth Desktop credentials in GCP, enable Calendar API, then obtain a refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# mock = never call Google (instant local schedule; keep GOOGLE_* for later)
# auto = try Google, fall back to mock on timeout
# google = always try Google
CALENDAR_MODE=mock
# Optional knobs when CALENDAR_MODE=auto|google
# GOOGLE_HTTP_TIMEOUT_SEC=8
# GOOGLE_CIRCUIT_COOLDOWN_SEC=300

# Optional: timezone for calendar events / alternate slots
EXECUTIVE_TIMEZONE=Africa/Addis_Ababa

# Phase 2 — Cloud Scheduler / webhooks
SCHEDULER_SECRET=change-me
CALENDAR_WEBHOOK_TOKEN=change-me
PUBLIC_BASE_URL=https://your-cloud-run-url.example.com
